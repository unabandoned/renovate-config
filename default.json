{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Base Renovate preset for @unabandoned forks: keep dependencies current, automerge them nightly, pin the supply chain, flag anything that itself becomes abandoned, and fast-track security fixes.",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    "helpers:disableTypesNodeMajor",
    "security:openssf-scorecard",
    "abandonments:recommended",
    ":enableVulnerabilityAlerts",
    ":automergeStableNonMajor",
    "schedule:nightly",
    "group:linters"
  ],
  "rebaseWhen": "behind-base-branch",
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "automerge": true,
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null
  },
  "forkProcessing": "enabled"
}
