{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Base Renovate preset for @unabandoned forks: keep dependencies current, soak new releases before adopting them, automerge once green, pin the supply chain, flag anything that itself becomes abandoned, and fast-track security fixes.",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    "helpers:disableTypesNodeMajor",
    "security:openssf-scorecard",
    "abandonments:recommended",
    ":enableVulnerabilityAlerts",
    ":automergeStableNonMajor",
    "group:linters"
  ],
  "rebaseWhen": "behind-base-branch",
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "matchDepTypes": [
        "dependencies"
      ],
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "automerge": true,
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": "0 seconds"
  },
  "forkProcessing": "enabled"
}
