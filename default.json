{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Base Renovate preset for @unabandoned forks: keep dependencies current, automerge them nightly, pin the supply chain, flag anything that itself becomes abandoned, and fast-track security fixes.",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    "helpers:disableTypesNodeMajor",
    "security:openssf-scorecard",
    "abandonments:recommended",
    ":enableVulnerabilityAlerts",
    ":automergeStableNonMajor",
    "group:linters"
  ],
  "schedule": ["after 10pm", "before 6am"],
  "rebaseWhen": "behind-base-branch",
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "matchDepTypes": ["dependencies"],
      "semanticCommitType": "fix"
    }
  ],
  "lockFileMaintenance": { "enabled": true },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "automerge": true,
    "schedule": ["at any time"]
  },
  "forkProcessing": "enabled"
}
